# Test-harness configuration (development only).
# The shipped extension has NO environment variables and NO configuration files —
# it is a self-contained unpacked folder (see PRD §1 and §7).
#
# These variables are consumed exclusively by the Playwright test launcher in
# tests/e2e/ to select which local Chrome/Chromium binary to test against.

# Chrome channel to use for E2E tests: stable | beta | dev | chromium
CHROME_CHANNEL=stable

# Per-test timeout for the E2E suite, milliseconds
TEST_TIMEOUT_MS=30000
